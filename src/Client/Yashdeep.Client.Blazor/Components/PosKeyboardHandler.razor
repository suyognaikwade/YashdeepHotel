@using Microsoft.AspNetCore.Components.Web
@using Yashdeep.Application.Pos.UI

<div class="pos-keyboard-container" tabindex="0" @onkeydown="HandleKeyDown" autofocus>
    @ChildContent
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public PosTerminalUiController? Controller { get; set; }

    [Parameter]
    public EventCallback<PosKeyboardAction> OnActionTriggered { get; set; }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var action = e.Key switch
        {
            "F1" => PosKeyboardAction.NewOrder,
            "F2" => PosKeyboardAction.AddLineItem,
            "F5" => PosKeyboardAction.PrintKot,
            "F8" => PosKeyboardAction.GenerateBill,
            "F10" => PosKeyboardAction.SettlePayment,
            "Escape" => PosKeyboardAction.Cancel,
            _ => PosKeyboardAction.None
        };

        if (action != PosKeyboardAction.None)
        {
            await OnActionTriggered.InvokeAsync(action);
        }
    }
}
