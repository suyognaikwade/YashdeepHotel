<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target framework configuration: net9.0 default in CLI environments, with MAUI mobile/desktop TFMs enabled when EnableMauiPlatforms is true -->
    <TargetFramework>net9.0</TargetFramework>
    <TargetFrameworks Condition="'$(EnableMauiPlatforms)' == 'true' AND $([MSBuild]::IsOSPlatform('windows'))">net9.0-windows10.0.19041.0;net9.0-android;net9.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableMauiPlatforms)' == 'true' AND !$([MSBuild]::IsOSPlatform('windows'))">net9.0-android;net9.0</TargetFrameworks>
    <UseMaui Condition="'$(EnableMauiPlatforms)' == 'true'">true</UseMaui>
    <UseMauiBlazor Condition="'$(EnableMauiPlatforms)' == 'true'">true</UseMauiBlazor>
    <RootNamespace>Yashdeep.Client.Maui</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yashdeep.Client.Blazor\Yashdeep.Client.Blazor.csproj" />
    <ProjectReference Include="..\..\Application\Yashdeep.Application\Yashdeep.Application.csproj" />
    <ProjectReference Include="..\..\Domain\Yashdeep.Domain\Yashdeep.Domain.csproj" />
    <ProjectReference Include="..\..\Shared\Yashdeep.Shared\Yashdeep.Shared.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Yashdeep.Infrastructure\Yashdeep.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Persistence\Yashdeep.Persistence.Local\Yashdeep.Persistence.Local.csproj" />
    <ProjectReference Include="..\..\SyncEngine\Yashdeep.SyncEngine\Yashdeep.SyncEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
